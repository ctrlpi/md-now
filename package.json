{
  "name": "md-now",
  "version": "0.9.14",
  "description": "A tiny, zero-dependency local Markdown browser. Scans a folder tree and renders Markdown.",
  "keywords": [
    "markdown",
    "md",
    "viewer",
    "browser",
    "preview",
    "cli",
    "server"
  ],
  "license": "MIT",
  "author": "ctrlPi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctrlpi/md-now.git"
  },
  "homepage": "https://github.com/ctrlpi/md-now#readme",
  "bugs": {
    "url": "https://github.com/ctrlpi/md-now/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "bin": {
    "md-now": "server.js",
    "mdv": "server.js"
  },
  "main": "server.js",
  "files": [
    "server.js",
    "page.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.js",
    "start": "node server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=page.html server.js --no-open"
  },
  "engines": {
    "node": ">=22"
  }
}
